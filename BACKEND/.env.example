# Server
PORT=5000
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/chefstar

# Auth
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=7d

# Admin seed
ADMIN_NAME=Chef Star
ADMIN_EMAIL=chef@chefstar.kitchen
ADMIN_PHONE=2348012345678
ADMIN_PASSWORD=change_me

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Geocoding (OpenStreetMap Nominatim — no key required)
DELIVERY_COUNTRY=NG

# Backend public URL (used for absolute image URLs in seed)
BACKEND_URL=http://localhost:5000