# Server
PORT=5000
NODE_ENV=development

# Frontend (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
MONGO_URI=your_mongodb_uri_here

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Admin seed (used once to create the initial admin account)
ADMIN_NAME="Chef Star Al-Amin"
ADMIN_EMAIL=chef@chefstar.kitchen
ADMIN_PHONE=2348012345678
ADMIN_PASSWORD=change_me_after_first_login

# Paystack (test keys for now)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx
CLOUDINARY_FOLDER=chefstar